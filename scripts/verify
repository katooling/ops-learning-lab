#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

browser_root="$repo_root/tests/browser"
if [ ! -d "$browser_root/node_modules/@playwright/test" ]; then
  echo "release verification needs the test-only browser dependencies." >&2
  echo "Run: npm --prefix tests/browser ci" >&2
  echo "Then: (cd tests/browser && npx playwright install chromium)" >&2
  exit 1
fi
browser_executable=$(
  cd "$browser_root"
  node -e \
    "const { chromium } = require('@playwright/test'); process.stdout.write(chromium.executablePath())"
)
if [ ! -x "$browser_executable" ]; then
  echo "release verification needs the test-only Chromium binary." >&2
  echo "Run: (cd tests/browser && npx playwright install chromium)" >&2
  exit 1
fi

./scripts/verify-fast
python3 scripts/audit_history.py
./scripts/verify-browser

# Browser tooling must not have made the publishable tree unsafe.
python3 scripts/audit_publication.py
