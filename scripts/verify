#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

PYTHONPATH=src python3 -m unittest discover -s tests -v
python3 -m compileall -q src tests scripts
python3 scripts/check_markdown_links.py
python3 scripts/audit_publication.py

install_root=$(mktemp -d "${TMPDIR:-/tmp}/ops-learning-lab-verify.XXXXXX")
cleanup() {
  rm -rf "$install_root"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

python3 -m venv "$install_root"
"$install_root/bin/python" -m pip install --disable-pip-version-check --no-deps -e .
"$install_root/bin/opslearn" --help >/dev/null
